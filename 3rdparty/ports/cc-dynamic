#!/bin/sh
# Compile or link against the HanOS musl sysroot with dynamic linking.
# Non-shared links produce a dynamic executable that loads /lib/ld64.so.1.
# Shared links produce a real shared object: the x86_64-elf driver drops
# -shared before collect2, so the link passes -Wl,-shared to the linker.
set -e

PORTS=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$PORTS/../.." && pwd)
MUSL="$ROOT/3rdparty/build/musl"
SYS="$ROOT/3rdparty/build/sysroot"
OVERLAY="$ROOT/3rdparty/musl"

BASE="-mcmodel=small -mno-red-zone -fcommon -O2 -nostdinc"
INCS="-I$MUSL/arch/x86_64 -I$MUSL/arch/generic -I$MUSL/obj/include -I$MUSL/include"

link=1
shared=0
reentrant=0
count=$#
index=0
while [ "$index" -lt "$count" ]; do
    arg=$1
    shift
    case "$arg" in
        -pthread) reentrant=1 ;;
        *)        set -- "$@" "$arg" ;;
    esac
    case "$arg" in
        -c|-S|-E|-M|-MM) link=0 ;;
        -shared)         shared=1 ;;
    esac
    index=$((index + 1))
done
# The bare-metal driver rejects -pthread; musl includes pthread in libc.
if [ "$reentrant" -eq 1 ]; then
    BASE="$BASE -D_REENTRANT"
fi

if [ "$link" -eq 0 ]; then
    exec x86_64-elf-gcc $BASE "$@" $INCS
fi

if [ "$shared" -eq 1 ]; then
    exec x86_64-elf-gcc $BASE "$@" $INCS -nostdlib \
        -Wl,-shared -Wl,-z,noexecstack -Wl,-rpath,/data/lib \
        -L"$SYS/usr/lib" -lc
fi

exec x86_64-elf-gcc $BASE "$@" $INCS -nostdlib -no-pie \
    -Wl,--dynamic-linker=/lib/ld64.so.1 -Wl,--enable-new-dtags -Wl,-rpath,/data/lib \
    -Wl,-z,noexecstack \
    "$SYS/usr/lib/crt1.o" "$SYS/usr/lib/crti.o" \
    -L"$SYS/usr/lib" -lc -lgcc "$SYS/usr/lib/crtn.o"
